{
  "name": "precomputer",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ietf-tools/red.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "TZ=UTC npm run test:unittests && npm run test:types",
    "test:types": "NODE_OPTIONS=--max-old-space-size=8192 vue-tsc -b --noEmit",
    "test:unittests": "TZ=UTC vitest run",
    "test:unittests:watch": "TZ=UTC vitest run --watch",
    "generate:test-data": "node ./src/utilities/rfcs-test-data-regenerate.ts",
    "generate:schema": "node ./src/utilities/export-json-schema.ts",
    "generate:api": "npx --no apigen-ts http://localhost:8000/api/schema/ --inline-enums --parse-dates ./generated/api-client.ts",
    "dev-api-server": "node ./src/utilities/dev-api-server.ts",
    "format": "oxfmt --ignore-path=.oxfmtignore ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/core": "3.980.1",
    "@napi-rs/canvas": "1.1.0",
    "@supercharge/promise-pool": "3.3.0",
    "@types/luxon": "3.7.6",
    "apigen-ts": "1.4.0",
    "es-toolkit": "1.53.2",
    "feed": "6.0.0",
    "jsdom": "31.0.0",
    "libxml2-wasm": "0.7.2",
    "luxon": "3.7.2",
    "micromark": "4.0.3",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "sanitize-html": "2.18.1",
    "satori": "0.63.2",
    "satori-html": "0.3.2",
    "sharp": "0.35.5",
    "sitemap": "10.0.0",
    "unpdf": "2.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "fastify": "5.12.8",
    "oxfmt": "0.77.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
