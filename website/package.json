{
  "name": "red",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "npx --no nuxt analyze",
    "build": "npm run build:nuxt",
    "build:nuxt": "npx --no nuxt build",
    "build:dev": "npm run build:nuxt:dev",
    "build:nuxt:dev": "npx --no nuxt prepare && npx --no nuxt build --envName development",
    "dev": "npm run dev:nuxt",
    "dev:nuxt": "nuxt dev",
    "dev:fixtures": "NUXT_PUBLIC_REEF_API=${NUXT_PUBLIC_REEF_API:-on} NUXT_PUBLIC_REEF_PRECOMPUTED_SOURCE=${NUXT_PUBLIC_REEF_PRECOMPUTED_SOURCE:-staging} npm run dev:nuxt",
    "dev:staging": "NUXT_PUBLIC_REEF_PRECOMPUTED_SOURCE=staging npm run dev:nuxt",
    "dev:prod": "NUXT_PUBLIC_REEF_PRECOMPUTED_SOURCE=prod npm run dev:nuxt",
    "cleanup": "nuxt cleanup",
    "preview": "npm run build:nuxt && nuxt preview",
    "preview:prod": "NUXT_PUBLIC_API_V1_BASE=https://www.rfc-editor.org npm run preview",
    "preview:dev": "npm run build:nuxt:dev && nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "TZ=UTC npm run test:unittests && npm run test:types && npm run test:lint",
    "test:lint": "oxlint",
    "test:lint:fix": "oxlint --fix",
    "test:format": "oxfmt --check .",
    "format": "oxfmt .",
    "fix": "oxlint --fix && oxfmt .",
    "test:types": "nuxt prepare && vue-tsc -b --noEmit",
    "test:unittests": "TZ=UTC vitest run --project unit",
    "test:unittests:watch": "TZ=UTC vitest --project unit",
    "test:unittests:search-index": "TZ=UTC vitest run --project search-index --disableConsoleIntercept",
    "test:unittests:search-index:staging": "SEARCH_INDEX_TARGET=staging TZ=UTC vitest run --project search-index --disableConsoleIntercept",
    "test:unittests:search-index:ingest-csv": "node ./e2e/search-index/ingest.ts",
    "test:unittests:search-index:capture-baseline": "node ./e2e/search-index/capture-baseline.ts",
    "test:e2e:deployed": "vitest run --project deployed",
    "test:e2e": "nuxt prepare && TZ=UTC vitest run --project e2e",
    "test:e2e:watch": "nuxt prepare && TZ=UTC vitest watch --project e2e",
    "test:e2e:headed": "nuxt prepare && E2E_HEADED=1 TZ=UTC vitest run --project e2e --no-file-parallelism --maxConcurrency=1",
    "test:e2e:review": "node ./scripts/screenshot-review.ts",
    "test:e2e:update-screenshots": "nuxt prepare && UPDATE_SCREENSHOTS=1 TZ=UTC vitest run --project e2e",
    "generate:reef-api-client": "npx --no openapi-typescript ./reef_api.yaml -o ./generated/reef-api-client.d.ts",
    "generate:reef-api-zod": "npx --no typed-openapi ./reef_api.yaml --runtime zod --schemas-only --openapi-additional-properties-default -o ./generated/reef-api-zod.ts",
    "generate:content-metadata": "node ./scripts/generate-content-metadata.ts"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@opentelemetry/auto-instrumentations-web": "0.70.0",
    "@opentelemetry/context-zone": "3.1.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@pinia/nuxt": "1.0.3",
    "@tailwindcss/vite": "4.3.4",
    "@vueuse/core": "15.0.0",
    "commander": "15.0.0",
    "core-js": "3.51.0",
    "es-toolkit": "1.53.1",
    "luxon": "3.7.2",
    "micromark": "4.0.3",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "nitropack": "2.13.6",
    "nuxt": "4.6.4",
    "nuxt-vitalizer": "3.0.0",
    "oidc-client-ts": "3.5.0",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "postcss-nested-import": "1.3.0",
    "reka-ui": "2.11.0",
    "simple-git": "4.0.2",
    "survey-core": "3.2.4",
    "survey-vue3-ui": "3.2.4",
    "tailwindcss": "4.3.4",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/runtime": "8.1.0",
    "@nuxt/test-utils": "4.3.4",
    "@types/luxon": "3.7.6",
    "@types/pngjs": "6.0.5",
    "@vue/test-utils": "2.5.1",
    "fast-xml-parser": "5.12.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.0",
    "playwright-core": "1.65.0",
    "pngjs": "7.0.0",
    "typed-openapi": "4.1.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    },
    "tinypool": ">=2.1.2",
    "undici": ">=7.31.0",
    "fflate": ">=0.7.5"
  }
}
