{
  "name": "rfced-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy --env staging",
    "dev": "wrangler dev --env staging",
    "dev-remote": "wrangler dev --env staging --remote",
    "cf-typegen": "wrangler types --env staging",
    "test": "npm run test:unittests && npm run test:types",
    "test:unittests": "TZ=UTC vitest run",
    "test:unittests:watch": "TZ=UTC vitest",
    "test:types": "tsc --noEmit",
    "format": "oxfmt ."
  },
  "dependencies": {
    "itty-router": "5.0.24",
    "luxon": "3.7.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "wrangler": "4.158.0"
  }
}
