#!/bin/sh
# main.hfsplus - an HFS+ disk image with MAIN.TXT inside. Creating HFS+ needs macOS.
# usage (on a Mac): sh main.hfsplus
if ! command -v hdiutil >/dev/null; then
  echo "hdiutil not found: run this on macOS. (Linux: mkfs.hfsplus from hfsprogs only formats; filling needs a root mount.)"
  exit 1
fi
hdiutil create -size 8m -fs HFS+ -volname KDP -ov kdp-hfsplus.dmg >/dev/null || exit 1
MNT=$(hdiutil attach kdp-hfsplus.dmg | awk -F'\t' '/\/Volumes\//{print $NF}')
printf '=== KDP Forum Profile ===\nNickname : KDPMember:KL5UQ4f48673352\nCode     : KL5UQ4f48673352\nRole     : Member\nPoints   : 1\n' > "$MNT/MAIN.TXT"
cat "$MNT/MAIN.TXT"
hdiutil detach "$MNT" >/dev/null
echo "wrote kdp-hfsplus.dmg (HFS+, volume KDP)"
